{
  "openapi": "3.1.1",
  "info": {
    "title": "Конвертер файлов — внешний API",
    "version": "0.2.0",
    "description": "Проект контракта MVP, 17 ноября 2026 г. Реализация ещё не создана. Только JPEG/PNG/DOCX, один файл на задачу. Все пути требуют персонального API-ключа."
  },
  "servers": [
    {
      "url": "https://converter.example/api/v1",
      "description": "Вымышленный адрес. Заменить при развёртывании."
    }
  ],
  "security": [
    {
      "PersonalApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Конвертация",
      "description": "Приём, статус, отмена и получение результатов."
    }
  ],
  "paths": {
    "/formats": {
      "get": {
        "operationId": "listFormats",
        "tags": [
          "Конвертация"
        ],
        "summary": "Форматы и лимиты",
        "responses": {
          "200": {
            "description": "Доступные направления.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormatsResponse"
                },
                "example": {
                  "formats": [
                    {
                      "id": "jpg_to_png",
                      "inputExtensions": [
                        ".jpg",
                        ".jpeg"
                      ],
                      "inputMimeType": "image/jpeg",
                      "outputMimeType": "image/png",
                      "maxInputBytes": 10485760,
                      "maxOutputBytes": 52428800,
                      "maxOutputPages": null,
                      "timeoutSeconds": 30
                    },
                    {
                      "id": "png_to_jpg",
                      "inputExtensions": [
                        ".png"
                      ],
                      "inputMimeType": "image/png",
                      "outputMimeType": "image/jpeg",
                      "maxInputBytes": 10485760,
                      "maxOutputBytes": 52428800,
                      "maxOutputPages": null,
                      "timeoutSeconds": 30
                    },
                    {
                      "id": "docx_to_pdf",
                      "inputExtensions": [
                        ".docx"
                      ],
                      "inputMimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                      "outputMimeType": "application/pdf",
                      "maxInputBytes": 20971520,
                      "maxOutputBytes": 52428800,
                      "maxOutputPages": 200,
                      "timeoutSeconds": 120
                    }
                  ],
                  "limits": {
                    "maxRequestBytes": 22020096,
                    "maxActiveJobsPerUser": 2,
                    "startsPerMinute": 10,
                    "startsPerDayUTC": 100,
                    "statusRequestsPerMinute": 120,
                    "maxQueuedJobs": 100,
                    "queueTimeoutSeconds": 600,
                    "temporaryResultSeconds": 3600,
                    "maxSavedFiles": 100,
                    "maxSavedBytes": 524288000
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "429": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/conversions": {
      "post": {
        "operationId": "createConversion",
        "tags": [
          "Конвертация"
        ],
        "summary": "Загрузить файл и создать задачу",
        "description": "Idempotency-Key обязателен. Один файл; поля в любом порядке. Поле save_to_profile имеет приоритет над настройкой. 24 часа идемпотентности, общий контур web/API. Подробности в docs/03-api.md.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "description": "UUID v4; повтор того же запроса использует прежний ключ."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversion"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Задача принята после сохранения исходника и commit очереди. Это не результат конвертации.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                },
                "example": {
                  "id": "01949d50-23a0-4000-8000-000000000001",
                  "conversion": "docx_to_pdf",
                  "source": "api",
                  "status": "queued",
                  "stage": "queued",
                  "attempts": 0,
                  "saveToProfile": false,
                  "createdAt": "2026-11-16T10:00:00Z",
                  "finishedAt": null,
                  "warnings": [],
                  "result": null,
                  "error": null
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Относительный URL статуса задачи."
              },
              "Retry-After": {
                "description": "Ожидание до следующей попытки в секундах.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "200": {
            "description": "Точный повтор ранее принятого запроса, без повторного запуска.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "408": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "413": {
            "$ref": "#/components/responses/Failure"
          },
          "415": {
            "$ref": "#/components/responses/Failure"
          },
          "422": {
            "$ref": "#/components/responses/Failure"
          },
          "429": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/conversions/{job_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "operationId": "getConversion",
        "tags": [
          "Конвертация"
        ],
        "summary": "Прочитать состояние своей задачи",
        "responses": {
          "200": {
            "description": "Состояние прочитано. failed внутри тела не означает HTTP 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                },
                "example": {
                  "id": "01949d50-23a0-4000-8000-000000000001",
                  "conversion": "docx_to_pdf",
                  "source": "api",
                  "status": "succeeded",
                  "stage": "completed",
                  "attempts": 1,
                  "saveToProfile": false,
                  "createdAt": "2026-11-16T10:00:00Z",
                  "finishedAt": "2026-11-16T10:00:08Z",
                  "warnings": [],
                  "result": {
                    "fileName": "document.pdf",
                    "mimeType": "application/pdf",
                    "sizeBytes": 184320,
                    "downloadPath": "/api/v1/conversions/01949d50-23a0-4000-8000-000000000001/file",
                    "available": true,
                    "expiresAt": "2026-11-16T11:00:08Z"
                  },
                  "error": null
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "429": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/conversions/{job_id}/file": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "operationId": "downloadConversion",
        "tags": [
          "Конвертация"
        ],
        "summary": "Скачать доступный результат своей задачи",
        "description": "Ключ проверяется на каждом запросе. Cookie не заменяет его. Временный результат доступен час после успеха; сохранённый — до удаления. Чужой ID: 404; владельцу просроченного/удалённого: 410.",
        "responses": {
          "200": {
            "description": "Бинарный файл, не JSON. Начало скачивания не доказывает сохранение на устройстве.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "example": "attachment; filename=\"document.pdf\""
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "private, no-store"
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string"
                },
                "example": "nosniff"
              }
            },
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "410": {
            "$ref": "#/components/responses/Failure"
          },
          "429": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/conversions/{job_id}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "operationId": "cancelConversion",
        "tags": [
          "Конвертация"
        ],
        "summary": "Отменить ожидающую/обрабатываемую задачу",
        "description": "Повтор cancelled возвращает то же состояние; succeeded/failed возвращают 409. Гонка отмены/успеха разрешается атомарно.",
        "responses": {
          "200": {
            "description": "Терминальное состояние cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "429": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PersonalApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque API key",
        "description": "Персональный ключ из кабинета. Не JWT, не cookie и не параметр URL."
      }
    },
    "parameters": {
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "Структурированная ошибка; код и HTTP описаны в docs/03-api.md. Retry-After обязателен для 429 и для 503 с планируемым повтором.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "FILE_TOO_LARGE",
                "message": "Для DOCX допустимо не больше 20 MiB.",
                "requestId": "req_example_001",
                "retryable": false,
                "details": {
                  "maxBytes": 20971520
                }
              }
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Ожидание до следующей попытки в секундах.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "schemas": {
      "Conversion": {
        "type": "string",
        "enum": [
          "jpg_to_png",
          "png_to_jpg",
          "docx_to_pdf"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "EMPTY_FILE",
              "MULTIPLE_FILES_NOT_ALLOWED",
              "IDEMPOTENCY_KEY_REQUIRED",
              "INVALID_IDEMPOTENCY_KEY",
              "INVALID_API_KEY",
              "ACCOUNT_DISABLED",
              "JOB_NOT_FOUND",
              "UPLOAD_TIMEOUT",
              "STORAGE_QUOTA_EXCEEDED",
              "IDEMPOTENCY_CONFLICT",
              "REQUEST_IN_PROGRESS",
              "JOB_NOT_READY",
              "JOB_ALREADY_FINISHED",
              "JOB_FAILED",
              "JOB_CANCELLED",
              "RESULT_EXPIRED",
              "RESULT_DELETED",
              "FILE_TOO_LARGE",
              "REQUEST_TOO_LARGE",
              "UNSUPPORTED_FILE_TYPE",
              "FILE_TYPE_MISMATCH",
              "UNSUPPORTED_CONVERSION",
              "INVALID_FILE",
              "FILE_COMPLEXITY_EXCEEDED",
              "UNSUPPORTED_DOCUMENT_FEATURE",
              "RATE_LIMITED",
              "ACTIVE_JOB_LIMIT",
              "INTERNAL_ERROR",
              "QUEUE_FULL",
              "STORAGE_UNAVAILABLE",
              "SERVICE_UNAVAILABLE",
              "CONVERSION_FAILED",
              "CONVERSION_TIMEOUT",
              "QUEUE_TIMEOUT",
              "RESULT_TOO_LARGE",
              "INFRASTRUCTURE_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "retryable"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ]
      },
      "Warning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FONT_SUBSTITUTED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fileName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "null после очистки имени временного результата."
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "application/pdf"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 52428800
          },
          "downloadPath": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/api/v1/conversions/[0-9a-f-]+/file$"
          },
          "available": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "fileName",
          "mimeType",
          "sizeBytes",
          "downloadPath",
          "available",
          "expiresAt"
        ]
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversion": {
            "$ref": "#/components/schemas/Conversion"
          },
          "source": {
            "type": "string",
            "enum": [
              "web",
              "api"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "validating",
              "converting",
              "retrying",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "saveToProfile": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Result"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "conversion",
          "source",
          "status",
          "stage",
          "attempts",
          "saveToProfile",
          "createdAt",
          "finishedAt",
          "warnings",
          "result",
          "error"
        ]
      },
      "Format": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Conversion"
          },
          "inputExtensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "inputMimeType": {
            "type": "string"
          },
          "outputMimeType": {
            "type": "string"
          },
          "maxInputBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxOutputPages": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "inputExtensions",
          "inputMimeType",
          "outputMimeType",
          "maxInputBytes",
          "maxOutputBytes",
          "maxOutputPages",
          "timeoutSeconds"
        ]
      },
      "Limits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxRequestBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxActiveJobsPerUser": {
            "type": "integer",
            "minimum": 1
          },
          "startsPerMinute": {
            "type": "integer",
            "minimum": 1
          },
          "startsPerDayUTC": {
            "type": "integer",
            "minimum": 1
          },
          "statusRequestsPerMinute": {
            "type": "integer",
            "minimum": 1
          },
          "maxQueuedJobs": {
            "type": "integer",
            "minimum": 1
          },
          "queueTimeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "temporaryResultSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "maxSavedFiles": {
            "type": "integer",
            "minimum": 1
          },
          "maxSavedBytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "maxRequestBytes",
          "maxActiveJobsPerUser",
          "startsPerMinute",
          "startsPerDayUTC",
          "statusRequestsPerMinute",
          "maxQueuedJobs",
          "queueTimeoutSeconds",
          "temporaryResultSeconds",
          "maxSavedFiles",
          "maxSavedBytes"
        ]
      },
      "FormatsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Format"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "required": [
          "formats",
          "limits"
        ]
      },
      "CreateConversion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "conversion": {
            "$ref": "#/components/schemas/Conversion"
          },
          "save_to_profile": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ],
            "description": "Необязательный override. При отсутствии сервер фиксирует текущую настройку аккаунта; replay сохраняет первоначальный снимок."
          },
          "file": {
            "type": "string",
            "format": "binary",
            "description": "Ровно один JPEG/PNG до 10 MiB или DOCX до 20 MiB, по направлению. Подтверждается содержимым."
          }
        },
        "required": [
          "conversion",
          "file"
        ]
      }
    }
  }
}
