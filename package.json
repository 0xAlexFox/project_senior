{
  "name": "converter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "File converter monorepo with Vue frontend preview",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:docs && npm run check:deps && npm run format:check && npm run format:web:check && npm run lint",
    "check:docs": "python3 scripts/verify_docs.py",
    "check:deps": "npm ls --all",
    "format:check": "prettier --check package.json 'apps/*/package.json' 'packages/*/package.json' \"scripts/**/*.{js,mjs}\" eslint.config.js stylelint.config.js .prettierrc.json jsconfig.json compose.yaml .vscode/settings.json",
    "format": "prettier --write package.json 'apps/*/package.json' 'packages/*/package.json' \"scripts/**/*.{js,mjs}\" eslint.config.js stylelint.config.js .prettierrc.json jsconfig.json compose.yaml .vscode/settings.json",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "db:config": "docker compose config --quiet",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "dev:web": "npm run dev --workspace @converter/web",
    "build:web": "npm run build --workspace @converter/web",
    "preview:web": "npm run preview --workspace @converter/web",
    "format:web:check": "prettier --check \"apps/web/**/*.{vue,js,html,css}\" \"tests/unit/**/*.js\" playwright.config.js \"tests/e2e/**/*.js\"",
    "format:web": "prettier --write \"apps/web/**/*.{vue,js,html,css}\" \"tests/unit/**/*.js\" playwright.config.js \"tests/e2e/**/*.js\"",
    "test:e2e": "playwright test",
    "setup:python": "python3 -m venv .local/lint-venv && .local/lint-venv/bin/python -m pip install --only-binary=:all: --requirement requirements-dev.txt",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:python",
    "lint:js": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix && npm run lint:python -- --fix",
    "lint:css": "stylelint \"apps/web/src/**/*.css\" --max-warnings 0",
    "lint:python": ".local/lint-venv/bin/python -m ruff check scripts tools",
    "test:unit:web": "vitest run --config apps/web/vitest.config.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-recommended": "19.1.0",
    "vue-eslint-parser": "10.4.2"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
